{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nimvelis",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-23",
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"],
  },
}
